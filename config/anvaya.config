# MLRITM Anvaya ERP Integration Configuration
# ==============================================================================
# This configuration controls whether the chatbot pulls live student records
# via Anvaya's server-to-server REST API (Primary Path) or gracefully deep-links
# the student directly into the relevant Anvaya /App portal page (Fallback Path).
#
# RULE: If base_url is blank, the entire application operates in Fallback Mode
# with zero external API dependencies and zero data copied.
# ==============================================================================

[anvaya_api]
# Production API Base URL (provided by MLRITM IT / OrgMaker vendor)
# Leave blank to run in Fallback (Deep-Link) Mode.
base_url = 

# Sandbox / Staging Base URL for testing before production release
sandbox_url = https://sandbox.anvaya.mlritm.ac.in/api
use_sandbox = false

# Authentication scheme: none | api_key | oauth2_client_credentials
auth_method = none

# Header name for API Key auth (e.g. X-API-Key or Authorization)
api_key_header = X-API-Key

# OAuth2 Token endpoint and Client ID (Client Secret passed via ANVAYA_OAUTH_CLIENT_SECRET env var)
oauth_token_url = 
oauth_client_id = 

# HTTP Timeout in seconds for live API calls
timeout_seconds = 10.0


# ------------------------------------------------------------------------------
# Per-Feature Read Endpoints (Optional)
# ------------------------------------------------------------------------------
# Template paths must include {roll_number}.
# Any endpoint left blank will automatically trigger the deep-link fallback.
# ------------------------------------------------------------------------------
[endpoints]
attendance = 
internal_marks = 
results = 
fees = 
timetable = 
exams = 
profile = 


# ------------------------------------------------------------------------------
# Per-Feature Anvaya Deep-Link Fallback URLs
# ------------------------------------------------------------------------------
# Direct portal paths inside https://anvaya.mlritm.ac.in/App/
# The student is already authenticated in Anvaya and views live data on-portal.
# ------------------------------------------------------------------------------
[deep_links]
attendance = https://anvaya.mlritm.ac.in/App/StudentAttendance
internal_marks = https://anvaya.mlritm.ac.in/App/InternalMarks
results = https://anvaya.mlritm.ac.in/App/ExamResults
fees = https://anvaya.mlritm.ac.in/App/FeePayments
timetable = https://anvaya.mlritm.ac.in/App/ClassTimetable
exams = https://anvaya.mlritm.ac.in/App/ExamSchedule
profile = https://anvaya.mlritm.ac.in/App/StudentProfile
