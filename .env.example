# MLRITM Academic Advising Chatbot Environment Configuration
PROJECT_NAME="MLRITM Academic Advising Chatbot"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-jwt"
AES_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef" # Exactly 32 characters for AES-256-GCM

# Environment: "production" (default, fail-closed) or "development" (enables mock launcher & debug features)
ENVIRONMENT="production"
ANVAYA_BASE_URL="https://anvaya.mlritm.ac.in"
ANVAYA_LOGIN_URL="https://anvaya.mlritm.ac.in/Login"
ANVAYA_APP_URL="https://anvaya.mlritm.ac.in/App"

# ---------------------------------------------------------------------------
# Anvaya SSO Launch Token (Signed Launch Button)
# Trust identity only from short-lived signed launch tokens (RS256 JWT).
# sub = Roll Number, iss = anvaya.mlritm.ac.in, aud = mlritm-chatbot, exp <= 120s
# ---------------------------------------------------------------------------
IDENTITY_PROVIDER="signed_launch"
IDENTITY_STUDENT_KEY_CLAIM="sub"
IDENTITY_ROLL_NUMBER_CLAIM="sub"
IDENTITY_NAME_CLAIM="name"
IDENTITY_ROLE_CLAIM=""
IDENTITY_STUDENT_ROLE_VALUES=""

LAUNCH_TOKEN_ISSUER="anvaya.mlritm.ac.in"
LAUNCH_TOKEN_AUDIENCE="mlritm-chatbot"
LAUNCH_TOKEN_ALGORITHMS="RS256"
LAUNCH_TOKEN_PUBLIC_KEY=""                      # PEM public key provided by Anvaya
LAUNCH_TOKEN_PUBLIC_KEY_FILE=""                 # Or path to PEM file
LAUNCH_TOKEN_JWKS_URL=""                        # Or Anvaya JWKS URL
LAUNCH_TOKEN_HMAC_SECRET=""                     # Only for HS256 in testbed
LAUNCH_TOKEN_MAX_AGE_SECONDS="120"              # Max 2 minutes lifetime

# ---------------------------------------------------------------------------
# Anvaya Live REST API (Primary Data Source)
# If ANVAYA_API_BASE_URL is left blank, the app runs in Fallback (Deep-Link) Mode.
# ---------------------------------------------------------------------------
ANVAYA_API_BASE_URL=""                          # Production API base (leave blank for Fallback Mode)
ANVAYA_API_SANDBOX_URL="https://sandbox.anvaya.mlritm.ac.in/api"
ANVAYA_API_USE_SANDBOX="false"

# Authentication method: none | api_key | oauth2_client_credentials
ANVAYA_API_AUTH="none"
ANVAYA_API_KEY=""
ANVAYA_API_KEY_HEADER="X-API-Key"

ANVAYA_OAUTH_TOKEN_URL=""
ANVAYA_OAUTH_CLIENT_ID=""
ANVAYA_OAUTH_CLIENT_SECRET=""

ANVAYA_API_TIMEOUT_SECONDS="10"

# Per-feature REST endpoints (relative to base URL, must contain {roll_number})
# Blank = automatically fall back to Anvaya deep-link for that feature
ANVAYA_PATH_ATTENDANCE=""
ANVAYA_PATH_MARKS=""
ANVAYA_PATH_RESULTS=""
ANVAYA_PATH_FEES=""
ANVAYA_PATH_TIMETABLE=""
ANVAYA_PATH_EXAMS=""
ANVAYA_PATH_PROFILE=""

# ---------------------------------------------------------------------------
# Anvaya Deep-Link URL Templates (Fallback Data Source)
# Used when ANVAYA_API_BASE_URL is blank or a specific feature endpoint is unconfigured.
# ---------------------------------------------------------------------------
ANVAYA_LINK_ATTENDANCE="https://anvaya.mlritm.ac.in/App/StudentAttendance"
ANVAYA_LINK_MARKS="https://anvaya.mlritm.ac.in/App/InternalMarks"
ANVAYA_LINK_RESULTS="https://anvaya.mlritm.ac.in/App/ExamResults"
ANVAYA_LINK_FEES="https://anvaya.mlritm.ac.in/App/FeePayments"
ANVAYA_LINK_TIMETABLE="https://anvaya.mlritm.ac.in/App/ClassTimetable"
ANVAYA_LINK_EXAMS="https://anvaya.mlritm.ac.in/App/ExamSchedule"
ANVAYA_LINK_PROFILE="https://anvaya.mlritm.ac.in/App/StudentProfile"

# ---------------------------------------------------------------------------
# Ephemeral Live Cache (DPDP Act 2023 Compliant)
# Live records are cached only in memory for a few minutes and never written to disk.
# ---------------------------------------------------------------------------
LIVE_CACHE_TTL_SECONDS="180"                    # 3 minutes in-memory cache

# Database (Seed data only: roll numbers, names, departments)
DATABASE_URL="sqlite+aiosqlite:///./academic_chatbot.db"

# Model Paths
MODEL_PATH="models/mlritm-llama2-7b-q4_k_m.gguf"
HF_TOKEN=""

# Security & CORS
ALLOWED_ORIGINS='["https://anvaya.mlritm.ac.in", "http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'
ENFORCE_HTTPS="false"
